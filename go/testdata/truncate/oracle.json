{
  "table": {
    "basic": {
      "in": "## 标题\n正文\n> 顶层目录索引\n| a | b |\n| - | - |\n| 1 | 2 |\n\n后续内容",
      "out": "## 标题\n正文\n后续内容"
    },
    "noTable": {
      "in": "## 标题\n正文\n更多正文",
      "out": "## 标题\n正文\n更多正文"
    },
    "tableFirst": {
      "in": "| a | b |\n| - | - |\n| 1 | 2 |\n后续",
      "out": "后续"
    },
    "noTrailingBlank": {
      "in": "前文\n| a | b |\n| - | - |\n紧接内容",
      "out": "前文\n紧接内容"
    },
    "quoteThenTable": {
      "in": "> 引用\n| a | b |\n| - | - |",
      "out": ""
    },
    "indentedTable": {
      "in": "前文\n  | a | b |\n  | - | - |\n后续",
      "out": "前文\n后续"
    },
    "twoTables": {
      "in": "| a |\n| - |\n中间\n| b |\n| - |",
      "out": "中间\n| b |\n| - |"
    },
    "empty": {
      "in": "",
      "out": ""
    },
    "onlyTable": {
      "in": "| a |\n| - |",
      "out": ""
    },
    "emojiTable": {
      "in": "> 索引\n| 😀 | b |\n| - | - |\n\n后续",
      "out": "后续"
    },
    "quoteFarAway": {
      "in": "> 引用\n普通行\n| a |\n| - |",
      "out": "> 引用\n普通行"
    }
  },
  "truncate": {
    "plainOver": {
      "kind": "project-memory",
      "text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "cap": 20,
      "out": "xxxxxxxxxxxxxxxxxxxx\n<!-- project-memory truncated: 50 → 20 chars -->"
    },
    "plainUnder": {
      "kind": "project-memory",
      "text": "short",
      "cap": 100,
      "out": "short"
    },
    "xmlOver": {
      "kind": "seed-capsule",
      "text": "<seed-capsule>\nyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\n</seed-capsule>",
      "cap": 40,
      "out": "<seed-capsule>\n\nyyyyy\n<!-- truncated: 111 → 40 chars -->\n</seed-capsule>"
