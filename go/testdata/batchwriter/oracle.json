      "finalDecoded": "line1\n",
      "backupFiles": []
    },
    "secondLineQueued": {
      "note": "第二行排队（不 flush）——文件仍是首行内容",
      "preexisting": null,
      "observations": [
        {
          "after": "enqueue",
          "fileExists": true,
          "isZstd": true,
          "decoded": "line1\n"
        },
        {
          "after": "enqueue",
          "fileExists": true,
          "isZstd": true,
          "decoded": "line1\n"
        }
      ],
      "finalDecoded": "line1\n",
      "backupFiles": []
    },
    "mergePendingVisible": {
      "note": "**未 flush 的行对进程内读者可见**",
      "preexisting": null,
      "observations": [
        {
          "after": "enqueue",
          "fileExists": true,
          "isZstd": true,
          "decoded": "line1\n"
        },
        {
          "after": "enqueue",
          "fileExists": true,
          "isZstd": true,
          "decoded": "line1\n"
